{
  "name": "checklist",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "sun-dev checklist bun --hot --preload ./css-plugin.ts server.js",
    "build": "bun run build:client && bun run build:server",
    "postbuild": "command -v sun-notify >/dev/null 2>&1 && sun-notify checklist || true",
    "build:client": "bunx vite build --ssrManifest --outDir dist/client",
    "build:server": "bunx vite build --ssr src/entry-server.tsx --outDir dist/server",
    "graphql:generate": "bunx graphql-codegen --config codegen.ts",
    "schema:pull": "bunx graphql-codegen --config codegen.ts",
    "graphql:watch": "bunx graphql-codegen --config codegen.ts --watch",
    "lint": "bunx eslint",
    "pretty": "bunx prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "preview": "NODE_ENV=production bun --preload ./css-plugin.ts server.js",
    "cypress": "bunx cypress",
    "cypress:run": "bunx cypress run --browser chrome",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d db backend app",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e": "./e2e.sh",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/client-preset": "5.1.1",
    "@graphql-codegen/schema-ast": "^5.0.2",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.11.10",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "baseline-browser-mapping": "^2.9.11",
    "bun-types": "1.4.3",
    "cypress": "^15.18.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "pg": "^8.13.1",
    "prettier": "^3.9.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/formbody": "^9.0.0",
    "@fastify/http-proxy": "^11.5.0",
    "@fastify/middie": "^9.3.2",
    "@fastify/static": "^9.1.3",
    "@heroicons/react": "^2.2.0",
    "@sun/analytics": "^0.1.2",
    "@sun/api": "^0.2.8",
    "@sun/components": "^0.12.0",
    "@sun/events": "^0.1.1",
    "@sun/shared": "^0.2.12",
    "@sun/ssr": "^0.7.0",
    "@sun/themes": "^0.2.10",
    "@sun/utils": "^0.2.0",
    "@testing-library/user-event": "^14.6.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.9.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^6.22.0",
    "sirv": "^3.0.1"
  }
}
