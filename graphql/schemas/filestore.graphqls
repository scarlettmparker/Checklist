input BucketKeyInput {
  bucket: String!
  key: String!
}

input PresignInput {
  bucket: String!
  key: String!
  contentType: String
}

type FilestoreMutations {
  getPresignedUploadUrl(input: PresignInput!): String
  getPresignedUploadUrls(input: [PresignInput!]!): [String!]!
  getPresignedDownloadUrl(input: BucketKeyInput!): String
  deleteFile(input: BucketKeyInput!): Boolean
}

extend type Mutation {
  filestoreMutations: FilestoreMutations!
}
